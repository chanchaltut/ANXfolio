# Copy to .env.local for local work, and add the same keys in your host's environment settings.

# Production domain. Drives canonical URLs, the sitemap, Open Graph tags and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Admin at /admin. Use a long, unique password. Changing it signs everyone out.
ADMIN_PASSWORD=

# Storage. Leave empty to store content in ./.data (any Node host with a persistent disk).
# On Vercel or other serverless hosts, create a free Upstash Redis database and paste its REST keys.
# The Vercel Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email delivery for briefs (optional, free tier at resend.com). Without it, briefs still land in the admin inbox.
RESEND_API_KEY=
# A sender on a domain verified in Resend. The default only delivers to the Resend account's own email.
MAIL_FROM=ANX Portfolio <briefs@your-domain.com>
